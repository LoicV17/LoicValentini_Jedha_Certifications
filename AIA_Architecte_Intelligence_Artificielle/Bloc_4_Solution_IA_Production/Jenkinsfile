pipeline {
    agent any

    environment {
        ENV = "PROD"  // active les vrais tests (pas de skip)
        DATABASE_URL = "postgresql://airflow:airflow@nmm_postgres:5432/airflow"
        VENV = ".venv"
    }

    triggers {
        cron('H * * * *')  // toutes les heures
    }

    stages {

        stage('Checkout') {
            steps {
                echo "📥 Récupération du code depuis GitHub..."
                checkout scm
            }
        }

        stage('Setup Python Environment') {
            steps {
                dir("AIA_Architecte_Intelligence_Artificielle/Bloc_4_Solution_IA_Production") {
                    echo "🐍 Création et activation de l'environnement virtuel..."
                    sh """
                        python3 -m venv ${VENV}
                        . ${VENV}/bin/activate
                        pip install --upgrade pip
                        pip install -r requirements.txt
                    """
                }
            }
        }

        stage('Run Pytest') {
            steps {
                dir("AIA_Architecte_Intelligence_Artificielle/Bloc_4_Solution_IA_Production") {
                    echo "🧪 Exécution des tests PyTest..."
                    sh """
                        . ${VENV}/bin/activate
                        pytest src/tests/ --junitxml=test-results/results.xml --maxfail=1 -v
                    """
                }
            }
            post {
                always {
                    echo "📊 Publication des rapports de tests..."
                    junit 'AIA_Architecte_Intelligence_Artificielle/Bloc_4_Solution_IA_Production/test-results/results.xml'
                }
            }
        }

        stage('Generate Evidently Report') {
            steps {
                dir("AIA_Architecte_Intelligence_Artificielle/Bloc_4_Solution_IA_Production") {
                    echo "📈 Génération du rapport Evidently..."
                    sh """
                        . ${VENV}/bin/activate
                        python src/evidently_jenkins/generate_evidently_report.py
                    """
                }
            }
        }

        stage('Archive Reports') {
            steps {
                echo "🗂 Archivage des rapports..."
                archiveArtifacts artifacts: 'AIA_Architecte_Intelligence_Artificielle/Bloc_4_Solution_IA_Production/data/reports/jenkins/*.html', fingerprint: true
            }
        }
    }

    post {
        success {
            echo "🎉 Succès du pipeline Reddit Data Quality !"
        }
        failure {
            echo "❌ ECHEC : Voir les logs pour identifier le problème."
        }
    }
}
