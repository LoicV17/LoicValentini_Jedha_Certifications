pipeline {
    agent any

    environment {
        VENV = ".venv"
    }

    stages {

        stage('Checkout') {
            steps {
                echo "📥 Récupération du code depuis GitHub..."
                checkout scm
            }
        }

        stage('Setup Python Environment') {
            steps {
                dir("AIA_Architecte_Intelligence_Artificielle/Bloc_4_Solution_IA_Production") {
                    echo "🐍 Création et activation de l'environnement virtuel..."

                    sh """
                        python3 -m venv ${VENV}
                        . ${VENV}/bin/activate

                        pip install --upgrade pip
                        pip install -r requirements.txt
                    """
                }
            }
        }

        stage('Run Pytest') {
            steps {
                dir("AIA_Architecte_Intelligence_Artificielle/Bloc_4_Solution_IA_Production") {
                    echo "🧪 Exécution des tests PyTest..."

                    sh """
                        . ${VENV}/bin/activate
                        pytest src/tests/ --maxfail=1 -v
                    """
                }
            }
        }

        stage('Publish Test Report') {
            steps {
                echo "📊 Publication des rapports de tests..."
            }
            post {
                always {
                    junit 'AIA_Architecte_Intelligence_Artificielle/Bloc_4_Solution_IA_Production/reports/junit/*.xml'
                }
            }
        }
    }

    post {
        success {
            echo "🎉 Pipeline Jenkins exécuté avec succès !"
        }
        failure {
            echo "❌ ECHEC : Voir les logs pour identifier le problème."
        }
    }
}
